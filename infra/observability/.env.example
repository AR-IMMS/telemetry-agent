OTEL_COLLECTOR_VERSION=0.160.0
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest

# Agent nodes connect to https://<Ubuntu-LAN-IP>:4317 with OTLP/HTTP JSON.
OTLP_TLS_PORT=4317
# HTTPS Fleet origin reachable by the ingress container.
OTLP_INGRESS_FLEET_ORIGIN=https://fleet.example.invalid:8443
# Absolute host directory containing server.crt, server.key, fleet-ca.crt,
# fleet-client.crt, and fleet-client.key. Keep it outside version control.
OTLP_INGRESS_CERT_DIR=/srv/ar-imms/otlp-ingress-certs

# Gateway health and Grafana remain local to the Ubuntu host in this PoC.
GATEWAY_HEALTH_PORT=13133
GRAFANA_PORT=13000
PROMETHEUS_DATA_PATH=/prometheus

PROMETHEUS_RETENTION=15d

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

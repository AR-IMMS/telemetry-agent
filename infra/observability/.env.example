OTEL_COLLECTOR_VERSION=0.160.0
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest

# Agent nodes connect to <Ubuntu-LAN-IP>:4317.
OTLP_GRPC_PORT=4317

# Gateway health and Grafana remain local to the Ubuntu host in this PoC.
GATEWAY_HEALTH_PORT=13133
GRAFANA_PORT=13000
PROMETHEUS_DATA_PATH=/prometheus

PROMETHEUS_RETENTION=15d

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123